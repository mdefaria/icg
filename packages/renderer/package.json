{
  "name": "@icg/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node-assets.ts",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "samples": "tsx scripts/samples.ts",
    "bench": "tsx scripts/bench.ts",
    "fetch-emoji": "tsx scripts/fetch-emoji.ts",
    "golden:update": "UPDATE_GOLDEN=1 vitest run golden"
  },
  "dependencies": {
    "@icg/shared": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "opentype.js": "^2.0.0",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@icg/avatars": "workspace:*",
    "@types/opentype.js": "^1.3.8",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0"
  }
}
