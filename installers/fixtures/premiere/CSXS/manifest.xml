<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal CEP panel used to test the signing and installer pipeline before
  apps/premiere exists. Same bundle id as the real panel but version 0.0.1,
  so a real install (higher version) always wins if both are present.
  Premiere 23 ships CEP 11, Premiere 25+ CEP 12; a CEP 11 manifest loads in both.
-->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  ExtensionBundleId="com.icg.premiere" ExtensionBundleVersion="0.0.1"
  ExtensionBundleName="ICG" Version="11.0">
  <ExtensionList>
    <Extension Id="com.icg.premiere.panel" Version="0.0.1" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.icg.premiere.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>ICG (installer fixture)</Menu>
          <Geometry>
            <Size>
              <Height>320</Height>
              <Width>320</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
